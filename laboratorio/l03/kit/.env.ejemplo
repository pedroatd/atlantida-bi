# Configuración de tu base del proyecto. `make base` copia este fichero a .env (solo lo lees tú)
# y genera la contraseña. No subas .env a ningún repositorio.

# Puerto de tu equipo en el que escucha la base (cámbialo si 5440 está ocupado).
PROYECTO_PUERTO=5440
# Usuario de PostgreSQL de la base.
PROYECTO_USUARIO=proyecto
# Contraseña: déjala vacía; `make base` genera una al azar y no la muestra.
PROYECTO_CLAVE=
# Carpeta con tus ficheros originales (CSV), relativa al kit.
PROYECTO_DATOS=./datos

# Nombre del proyecto de Docker Compose (por omisión, l03-proyecto, el de compose.yaml).
# Cámbialo si en tu equipo ya hay otro proyecto con ese nombre (p. ej. una segunda copia del kit):
# COMPOSE_PROJECT_NAME=l03-proyecto

# No hace falta cambiarlas (tienen estos valores por omisión):
# PROYECTO_HOST=127.0.0.1
# PROYECTO_BASE=proyecto
# PROYECTO_BASE_ORIGEN=proyecto_origen
# PROYECTO_ESTADO_DLT=./.dlt-estado
