# Copiado automáticamente a .env por `make up`. Valores SOLO para desarrollo local.
COMPOSE_PROJECT_NAME=atlantida
# Puertos publicados solo en 127.0.0.1; cámbialos si el puerto está ocupado.
PMS_PORT=5433
DWH_PORT=5434
PMS_DB=pms
PMS_USER=pms
PMS_PASSWORD=pms_dev_pw
DWH_DB=dwh
DWH_USER=dwh_admin
DWH_PASSWORD=dwh_dev_pw
LOADER_PASSWORD=loader_dev_pw
TRANSFORMER_PASSWORD=transformer_dev_pw
ML_WRITER_PASSWORD=ml_dev_pw
BI_READER_PASSWORD=bi_dev_pw
# Rol de solo lectura con el que las cargas y el sensor de Dagster leen el PMS (mínimo privilegio).
# Vacío PMS_EL_USER: las cargas usan el propietario del PMS (como antes).
PMS_EL_USER=pms_el
# Vacía: make la genera al azar en tu .env (no se muestra).
PMS_EL_PASSWORD=
# Cargas (EL). Origen del PMS: pms (la base local) o api (la API de cambios del profesor).
ORIGEN_PMS=api
# Solo con ORIGEN_PMS=api: URL de la API (termina en /v1) y, en SIM_API_TOKEN, el token que te dé
# el profesor (en tu equipo, SIM_API_TOKEN es el token del servicio al que te conectas).
SIM_API_URL=
SIM_API_TOKEN=
# URL del rate shopper (tarifas de la competencia) y su token. Vacía con ORIGEN_PMS=api: no se
# cargan esas tarifas (pide la URL al profesor); con pms, el rate shopper local. RS_TOKEN vacío:
# se usa SIM_API_TOKEN.
RS_URL=
RS_TOKEN=
# Reintentos ante un 503 del rate shopper.
RS_REINTENTOS=4
# Primer día de consulta de las tarifas de la competencia (vacío: desde el inicio del histórico;
# son muchas filas, una consulta por día: para probar, una fecha reciente).
RS_TARIFAS_DESDE=2024-01-01
# Motor de cargas cuyos datos lee dbt: dlt (por defecto) o airbyte (perfil full).
MOTOR_EL=dlt
# Airbyte (perfil full; ver platform/el/airbyte/README.md). Credenciales: abctl local credentials.
AIRBYTE_URL=http://localhost:8000
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
# Opcionales
AEMET_API_KEY=
# Otras etiquetas de imagen, solo para probar la plataforma en paralelo (vacías normalmente):
# IMAGEN_ELT=
